generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Page {
  id             String   @id @default(uuid())
  slug           String   @unique
  nomeCasal      String
  dataInicio     String
  mensagem       String
  fotoUrl        String
  spotifyTrackId String?
  theme          String   @default("romantic")
  createdAt      DateTime @default(now())
  orderId        String?  @unique
  order          Order?   @relation(fields: [orderId], references: [id])
}

model Order {
  id          String   @id
  tokenHash   String
  payload     String
  payerEmail  String
  payerCpf    String
  amountCents Int      @default(1990)
  paymentId   String?  @unique
  promoCodeHash String? @unique
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  page        Page?
  @@index([status, updatedAt])
}


model MetricEvent {
  id        String   @id @default(uuid())
  type      String
  orderId   String?
  pageSlug  String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
}
