generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Page {
  id         String   @id @default(uuid())
  slug       String   @unique
  nomeCasal  String
  dataInicio String
  mensagem   String
  fotoUrl    String
  createdAt  DateTime @default(now())
}