    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mercadopago": "^3.6.1",
    "qrcode": "^1.5.4",
    "zod": "^3.24.0",
    "express-rate-limit": "^7.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "prisma": "^5.18.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.0"
  }
