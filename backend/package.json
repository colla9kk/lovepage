{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/migrate-sqlite.cjs",
    "db:generate:postgres": "prisma generate --schema prisma/postgresql/schema.prisma",
    "db:migrate:postgres": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "db:import:postgres": "node --import tsx scripts/import-postgres.ts"
  },
  "keywords": [],
